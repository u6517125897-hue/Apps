{
  "expo": {
    "name": "MacroLens",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.workouttracker.r4q86a",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan meals and barcodes to log nutrition"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A0C10"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.workouttracker.r4q86a",
      "permissions": ["android.permission.CAMERA"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0A0C10"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan meals and barcodes to log nutrition"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
